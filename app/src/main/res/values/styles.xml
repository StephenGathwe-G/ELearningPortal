<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- University Branding -->
    <style name="PortalBrandStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Main Heading -->
    <style name="PortalHeadingStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Description -->
    <style name="PortalDescriptionStyle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Section Heading -->
    <style name="PortalSectionStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Input Field -->
    <style name="PortalInputStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/bg_login_input</item>
    </style>

    <!-- Primary Button -->
    <style name="PortalPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/primary_button</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Secondary Button -->
    <style name="PortalSecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/soft_blue</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Floating Pill Back Button Style -->
    <style name="PillBackButtonStyle">
        <item name="android:background">@drawable/bg_back_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Floating Bottom Nav Style -->
    <style name="Widget.Portal.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/primary</item>
        <item name="itemTextColor">@color/primary</item>

        <item name="itemRippleColor">@color/soft_blue</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>