<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- University Branding -->
    <style name="PortalBrandStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Main Heading -->
    <style name="PortalHeadingStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Description -->
    <style name="PortalDescriptionStyle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Section Heading -->
    <style name="PortalSectionStyle">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Input Field -->
    <style name="PortalInputStyle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/bg_login_input</item>
    </style>

    <!-- Primary Button -->
    <style name="PortalPrimaryButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/primary_button</item>
    </style>

    <!-- Secondary Button -->
    <style name="PortalSecondaryButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:backgroundTint">@color/soft_blue</item>
    </style>

</resources>
