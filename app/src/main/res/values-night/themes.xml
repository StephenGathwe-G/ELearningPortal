<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.ELearningPortal"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary University Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#101827</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">#101827</item>

        <item name="colorTertiary">@color/primary_button</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Light content on dark status bar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <style name="Theme.ELearningPortal"
        parent="Base.Theme.ELearningPortal" />

</resources>
