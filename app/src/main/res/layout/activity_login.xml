<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/school_logo_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_login_card"
            android:elevation="3dp">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/full_name"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="7dp"/>

            <!-- Name -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:autofillHints="@string/student_name_autofill_hint"
                android:hint="@string/student_name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_login_input"/>

            <!-- Email Address -->
            <TextView
                android:layout_marginBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_address"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="17dp"/>

            <!-- Email -->
            <EditText
                android:id="@+id/etEmail"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="7dp"
                android:autofillHints="@string/email_address_autofill_hint"
                android:hint="@string/email_address"
                android:inputType="textEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_login_input"/>

            <!-- Password Input -->
            <TextView
                android:layout_marginBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="17dp"/>

            <!-- Password -->
            <EditText
                android:id="@+id/etPassword"
                android:autofillHints="@string/password_autofill_hint"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:singleLine="true"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:background="@drawable/bg_login_input"/>

            <!-- Remember Me -->
            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/remember_me"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary_button"/>

            <!-- Buttons row -->
            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_weight="1"
                    android:text="@string/submit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary_button"/>

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:backgroundTint="@color/soft_blue"
                    android:layout_marginStart="8dp"
                    android:text="@string/cancel" />
            </LinearLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/forgot_password"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Progress (hidden by default) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>