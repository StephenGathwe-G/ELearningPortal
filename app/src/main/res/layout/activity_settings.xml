<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Left Back Pill Button -->
        <TextView
            android:id="@+id/btnSettingsBack"
            style="@style/PillBackButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- University Branding -->
        <TextView
            android:id="@+id/settingsBrand"
            style="@style/PortalBrandStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elearning_portal"/>

        <!-- Settings Heading -->
        <TextView
            android:id="@+id/settingsTitle"
            style="@style/PortalHeadingStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/settingsDescription"
            style="@style/PortalDescriptionStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/customize_your_student_portal_experience"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"/>

        <!-- General Preferences Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_preferences"
                    style="@style/PortalSectionStyle"
                    android:layout_marginBottom="14dp"/>

                <Switch
                    android:id="@+id/notificationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_notifications"
                    android:textColor="@color/text_primary"
                    android:paddingVertical="8dp"
                    android:buttonTint="@color/primary_button"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginVertical="12dp"/>

                <CheckBox
                    android:id="@+id/darkModeCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dark_mode"
                    android:textColor="@color/text_primary"
                    android:paddingVertical="8dp"
                    android:buttonTint="@color/primary_button"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Account Preferences Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_preferences"
                    style="@style/PortalSectionStyle"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preferred_username"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <EditText
                    android:id="@+id/preferredUsername"
                    style="@style/PortalInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/enter_preferred_username"
                    android:inputType="textPersonName"
                    android:singleLine="true"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Save Settings -->
        <Button
            android:id="@+id/saveSettingsButton"
            style="@style/PortalPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/save_settings"
            android:layout_marginTop="24dp"/>

        <!-- Reset Settings -->
        <Button
            android:id="@+id/resetSettingsButton"
            style="@style/PortalSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/reset_to_default"
            android:layout_marginTop="12dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/elearning_portal"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>