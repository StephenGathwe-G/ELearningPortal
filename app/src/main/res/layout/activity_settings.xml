<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- University Branding -->
        <TextView
            android:id="@+id/settingsBrand"
            style="@style/PortalBrandStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elearnig_portal"/>

        <!-- Settings Heading -->
        <TextView
            android:id="@+id/settingsTitle"
            style="@style/PortalHeadingStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:layout_marginTop="28dp"/>

        <TextView
            android:id="@+id/settingsDescription"
            style="@style/PortalDescriptionStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/customize_your_student_portal_experience"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"/>

        <!-- General Preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_login_card"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/general_preferences"
                style="@style/PortalSectionStyle"
                android:layout_marginBottom="14dp"/>

            <Switch
                android:id="@+id/notificationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_notifications"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp"
                android:buttonTint="@color/primary_button"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginVertical="12dp"/>

            <CheckBox
                android:id="@+id/darkModeCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dark_mode"
                android:textColor="@color/text_primary"
                android:paddingVertical="8dp"
                android:buttonTint="@color/primary_button"/>

        </LinearLayout>

        <!-- Account Preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_login_card"
            android:elevation="2dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_preferences"
                style="@style/PortalSectionStyle"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferred_username"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/preferredUsername"
                style="@style/PortalInputStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/enter_preferred_username"
                android:inputType="textPersonName"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- Save Settings -->
        <Button
            android:id="@+id/saveSettingsButton"
            style="@style/PortalPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/save_settings"
            android:layout_marginTop="24dp"/>

        <!-- Reset Settings -->
        <Button
            android:id="@+id/resetSettingsButton"
            style="@style/PortalSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/reset_to_default"
            android:layout_marginTop="12dp"/>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/elearnig_portal"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
