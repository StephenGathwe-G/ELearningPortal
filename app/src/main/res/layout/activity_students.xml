<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Left Back Pill Button -->
    <TextView
        android:id="@+id/btnStudentsBack"
        style="@style/PillBackButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvStudentsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/registered_students"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnStudentsBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Student List -->
    <ListView
        android:id="@+id/listStudents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:padding="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvStudentsTitle"
        app:layout_constraintBottom_toTopOf="@id/btnDeleteAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Delete All -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteAll"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="@string/delete_all"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="24dp"
        android:backgroundTint="@color/error"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>