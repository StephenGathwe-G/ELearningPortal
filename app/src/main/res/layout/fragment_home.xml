<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background">

    <TextView
        android:id="@+id/tvSchoolName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cambridge_university"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- School Mission -->
    <TextView
        android:id="@+id/tvMission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empowering_students_through_quality_education_innovation_and_excellence"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"

        app:layout_constraintTop_toBottomOf="@id/tvSchoolName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campus Image -->
    <ImageView
        android:id="@+id/imgCampus"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:src="@drawable/campus_building"
        android:scaleType="centerCrop"
        android:background="@color/surface"
        android:contentDescription="@string/school_campus"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/tvMission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Welcome Message -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_student"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/imgCampus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Last Login -->
    <TextView
        android:id="@+id/tvLastLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/last_login_not_available"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"

        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>